rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/looks/{lookId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 사용자가 수동으로 누끼 crop 영역을 보정할 때마다 쌓이는 개인화
    // 기록(personal crop correction heuristic 학습용) - 본인 것만 읽고 쓸 수 있다.
    match /users/{uid}/manualCropCorrections/{correctionId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
